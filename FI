<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enterprise Solutions | Professional Business Services</title>
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            line-height: 1.6;
            color: #333333;
            background-color: #f9f9f9;
        }

        /* Navigation */
        header {
            background-color: #ffffff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #0056b3;
            text-decoration: none;
        }

        .nav-links {
            list-style: none;
            display: flex;
        }

        .nav-links li {
            margin-left: 20px;
        }

        .nav-links a {
            text-decoration: none;
            color: #555555;
            font-weight: 600;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: #0056b3;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(0, 86, 179, 0.8), rgba(0, 40, 83, 0.9)), url('https://unsplash.com') no-repeat center center/cover;
            height: 100vh;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            margin-top: 60px;
        }

        .hero h1 {
            font-size: 48px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
            max-width: 600px;
        }

        .btn {
            display: inline-block;
            background-color: #ffc107;
            color: #212529;
            padding: 12px 30px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 5px;
            transition: background 0.3s;
        }

        .btn:hover {
            background-color: #e0a800;
        }

        /* Services Section */
        .services {
            max-width: 1200px;
            margin: 80px auto;
            padding: 0 20px;
            text-align: center;
        }

        .services h2 {
            font-size: 36px;
            margin-bottom: 40px;
            color: #222222;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .service-card {
            background: #ffffff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform 0.3s;
        }

        .service-card:hover {
            transform: translateY(-5px);
        }

        .service-card h3 {
            margin-bottom: 15px;
            color: #0056b3;
        }

        /* Footer */
        footer {
            background-color: #222222;
            color: #ffffff;
            text-align: center;
            padding: 30px 20px;
            margin-top: 40px;
        }

        /* Responsive Layout */
        @media (max-width: 768px) {
            .hero h1 { font-size: 32px; }
            .hero p { font-size: 16px; }
            .navbar { flex-direction: column; }
            .nav-links { margin-top: 15px; }
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <nav class="navbar">
            <a href="#" class="logo">EnterpriseCo</a>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Showcase Section -->
    <section id="home" class="hero">
        <h1>Grow Your Business Today</h1>
        <p>We provide industry-leading consulting, analytics, and digital transformation solutions to scale your operations seamlessly.</p>
        <a href="#contact" class="btn">Get Started Now</a>
    </section>

    <!-- Business Services Section -->
    <section id="services" class="services">
        <h2>Our Core Services</h2>
        <div class="services-grid">
            <div class="service-card">
                <h3>Financial Consulting</h3>
                <p>Maximize your revenue with data-driven financial planning and custom corporate tax management strategies.</p>
            </div>
            <div class="service-card">
                <h3>Digital Solutions</h3>
                <p>Build robust cloud architectures and web systems tailored to optimize customer experiences online.</p>
            </div>
            <div class="service-card">
                <h3>Market Research</h3>
                <p>Gain a highly competitive edge with deeply analytical insights regarding industry trends and buyer habits.</p>
            </div>
        </div>
    </section>

    <!-- Footer Copyright Section -->
    <footer>
        <p>&copy; 2026 EnterpriseCo. All rights reserved. | Professional Corporate Solutions</p>
    </footer>

</body>
</html>
